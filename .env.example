# ── PratiSIG Platform — configuration ─────────────────────────────
# Copier en .env et adapter. Tout est optionnel : la plateforme démarre
# sans aucune de ces variables, les modules concernés se désactivent
# proprement et /health indique lesquels.

# ── Ports ──────────────────────────────────────────────────────────
WEB_PORT=8080
API_PORT=8000

# ── Application ────────────────────────────────────────────────────
PRATISIG_ENVIRONMENT=development
PRATISIG_DEBUG=true

# ── Moteur DuckDB (modules Overture et Open Buildings) ─────────────
PRATISIG_DUCKDB_MEMORY_LIMIT=4GB
PRATISIG_DUCKDB_THREADS=4

# ── Overture Maps ──────────────────────────────────────────────────
# Versions disponibles : https://docs.overturemaps.org/release/
PRATISIG_OVERTURE_RELEASE=2025-01-22.0

# ── Google Earth Engine (modules Imagerie et Inondations) ──────────
# Compte de service : https://developers.google.com/earth-engine/guides/service_account
# Déposer la clé JSON dans ./secrets/ (ce dossier est ignoré par Git).
# PRATISIG_GEE_SERVICE_ACCOUNT_EMAIL=mon-service@mon-projet.iam.gserviceaccount.com
# PRATISIG_GEE_SERVICE_ACCOUNT_KEY_FILE=/secrets/gee-key.json

# ── Agent cartographique (optionnel) ───────────────────────────────
# PRATISIG_LLM_ENABLED=true
# PRATISIG_LLM_PROVIDER=openai
# PRATISIG_LLM_MODEL=gpt-4o-mini
# PRATISIG_LLM_API_KEY=sk-...

# ── Cache ──────────────────────────────────────────────────────────
PRATISIG_CACHE_ENABLED=true
PRATISIG_CACHE_TTL_SECONDS=86400

# ── Conversion / quotas ────────────────────────────────────────────
# Taille maximale d'un fichier importé (25 Mo par défaut)
PRATISIG_MAX_IMPORT_BYTES=26214400
PRATISIG_MAX_EXPORT_FEATURES=500000
